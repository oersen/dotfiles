{
    "height": 30,
    "modules-left": ["sway/workspaces", "wlr/taskbar"],
    "modules-center": ["sway/mode"],
    "modules-right": ["sway/scratchpad", "memory", "cpu", "temperature", "battery", "backlight", "pulseaudio#source", "pulseaudio", "idle_inhibitor", "clock", "tray"],
    "sway/mode": {
        "format": "☠️ {} ☠️",
        "tooltip": false
    },
    "sway/scratchpad": {
        "format": "{count} {icon}",
        "format-icons": ["", "💼"],
        "tooltip-format": "{app}: {title}"
    },
    "sway/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X"
        }
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["🔅", "🔆"],
        "on-click": "brightnessctl -qs set 1%",
        "on-click-middle": "brightnessctl -r",
        "on-click-right": "brightnessctl -qs set 100%",
        "on-scroll-down": "brightnessctl -q set 1%-",
        "on-scroll-up": "brightnessctl -q set 1%+",
        "tooltip": false
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ⚡",
        "format-plugged": "{capacity}% 🔌",
        "format-icons": ["🪫", "🔋"],
        "states": {
            "warning": 32,
            "critical": 16
        }
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a %d %b %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar" : {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "today": "<span color='#5f87af'><b><u>{}</u></b></span>",
                "days": "<span color='#bcbcbc'><b>{}</b></span>",
                "weekdays": "<span color='#5f5f87'><b>{}</b></span>",
                "months": "<span color='#5f8787'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-middle": "shift_reset",
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    },
    "cpu": {
        "format": "{usage}% ⚙️",
        "format-alt": "{load}% 🤖",
        "tooltip": false
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "😎",
            "deactivated": "😴"
        },
        "start-activated": true,
        "tooltip": false
    },
    "memory": {
        "format": "{percentage}% 🧮",
        "format-alt": "{used:0.1f}GiB 📊",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon} 🔵",
        "format-bluetooth-muted": "{volume}% ⛔🔵",
        "format-muted": "{volume}% ⛔",
        "format-icons": {
            "car": "🚗",
            "hands-free": "📣",
            "headphone": "🎧",
            "headset": "🗣️",
            "hdmi": "📺",
            "hifi": "🚄",
            "phone": "📞",
            "portable": "📟",
            "default": ["🔈", "🔉", "🔊"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol -t 3",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
        "tooltip": false
    },
    "pulseaudio#source": {
        "format": "{format_source}",
        "format-source": "{volume}% 🎙️",
        "format-source-muted": "{volume}% 🚫",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol -t 4",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%+",
        "tooltip": false
    },
    "temperature": {
        "critical-threshold": 80,
        "warning-threshold": 70,
        "format": "{temperatureC} °C 🌡️",
        "format-alt": "{temperatureF} °F 🌡️",
        "format-critical": "{temperatureC} °C 🌶️",
        "format-warning": "{temperatureC} °C 🥵",
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "wlr/taskbar": {
        "all-outputs": true,
        "format": "{icon}",
        "icon-size": 16,
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize"
    }
}
